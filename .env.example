# ---------------------------------------------------------------------------
# Spllit web — environment configuration
#
# Every value is read through lib/config.ts. Nothing in the app touches
# process.env directly, and no project id, key or token is hardcoded anywhere
# in source.
#
# Copy to .env.local for development, .env.production for production builds.
# ---------------------------------------------------------------------------

# development | staging | production — selects which backend/token set is live.
NEXT_PUBLIC_ENV=development

# --- API -------------------------------------------------------------------
# The backend runs in a Cloudflare Container behind a Worker; REST and
# websockets share one origin.
#   local:      http://localhost:3001/api
#   production: https://api.spllit.app/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# Same host WITHOUT the /api suffix — Socket.IO mounts at the root.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# --- Firebase (identity only: Google Sign-In + Phone OTP) -------------------
# No Firestore, RTDB or Storage — all application data lives in the Mongo API.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Must be the WEB app id (contains ":web:"), not the Android or iOS one.
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional. Carried into the Firebase config for completeness; the app does not
# read from Realtime Database — live data goes over Socket.IO to the API.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
# Optional. Analytics is not initialised — see lib/firebase.ts.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Mapbox ----------------------------------------------------------------
# Public token — client-side map rendering and geocoding autocomplete only.
# The Directions/ETA calls use a SERVER token held by the backend (never here).
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_MAPBOX_STYLE_LIGHT=mapbox://styles/mapbox/light-v11
NEXT_PUBLIC_MAPBOX_STYLE_DARK=mapbox://styles/mapbox/dark-v11

# --- Fallback location -----------------------------------------------------
# Used when geolocation is denied or unavailable, so the map is never blank.
NEXT_PUBLIC_DEFAULT_LNG=80.2367
NEXT_PUBLIC_DEFAULT_LAT=12.9915
NEXT_PUBLIC_DEFAULT_ZOOM=12
NEXT_PUBLIC_DEFAULT_PLACE=Chennai
