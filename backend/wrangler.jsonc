{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spllit-api",
  "main": "edge/worker.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Custom domain for the API. Point api.spllit.app at this Worker in the
  // Cloudflare dashboard (or via `routes` below) once the zone is set up.
  "routes": [{ "pattern": "api.spllit.app", "custom_domain": true }],

  "observability": { "enabled": true },

  // The container image is built from backend/Dockerfile and pushed to
  // Cloudflare's registry by `wrangler deploy`.
  "containers": [
    {
      "class_name": "SpllitBackend",
      "image": "./Dockerfile",
      // "dev" is the smallest instance; move to "basic"/"standard" as load grows.
      "instance_type": "basic",
      // Capped at 1: see the single-instance note in edge/worker.ts. Raising
      // this without a Socket.IO Redis adapter will break rooms and presence.
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "SpllitBackend" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpllitBackend"] }],

  // Non-secret configuration. Secrets go through `wrangler secret put` and are
  // never written here — see DEPLOY.md.
  "vars": {
    "NODE_ENV": "production",
    "FRONTEND_URL": "https://spllit.app",
    "JWT_EXPIRES_IN": "1h",
    "JWT_REFRESH_EXPIRES_IN": "7d"
  }
}
