{
  // Separate from ../tsconfig.json: the Worker entry compiles against the
  // Cloudflare runtime, while everything in ../src compiles against Node.
  // Mixing the two lib sets produces bogus errors in both directions.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["./**/*.ts"]
}
