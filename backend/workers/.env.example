# Cloudflare Workers Environment Variables

# Required environment variables (set via wrangler secret put)
# =============================================================

# URL of the Render backend server
RENDER_BACKEND_URL=https://spllit-backend.onrender.com

# JWT Secrets (MUST be set in Cloudflare Secrets, not in wrangler.toml)
JWT_SECRET=your-jwt-secret-key-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here

# Environment
ENVIRONMENT=production

# Optional: Firebase configuration (if direct Firebase access needed)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id

# Optional: Analytics
ENABLE_ANALYTICS=true
